{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "--- Grafana ---",
        "enable": true,
        "hide": true,
        "iconColor": "#000000",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "title": "ETL Pipeline Hotpath (Phase 0)",
  "tags": ["etl", "pipeline", "phase0"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "ETL records rate (in/out/dropped, stage=load)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7},
      "targets": [
        {"expr": "sum(rate(etl_records_in_total[1m]))", "legendFormat": "in"},
        {"expr": "sum(rate(etl_records_out_total[1m]))", "legendFormat": "out"},
        {"expr": "sum(rate(etl_records_dropped_total[1m]))", "legendFormat": "dropped"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Load duration P95 (etl_load_duration_seconds)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(etl_load_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.50, sum(rate(etl_load_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Full GC rate (per service)",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(jvm_gc_pause_seconds_count{action=\"end of major GC\"}[5m])", "legendFormat": "{{application}}/{{instance}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (max, per client)",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "targets": [
        {"expr": "kafka_consumer_fetch_manager_records_lag_max", "legendFormat": "{{client_id}} / topic {{topic}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Insert retries (etl_insert_retry_total)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(increase(etl_insert_retry_total[5m]))", "legendFormat": "retries/5m"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Deduped records (etl_records_deduped_total)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
      "targets": [
        {"expr": "sum(rate(etl_records_deduped_total[1m]))", "legendFormat": "deduped/s"}
      ]
    }
  ]
}
